# Advanced public/system example. Normal setup writes gateway.env automatically.
SLNCTRZ_HOST=0.0.0.0
SLNCTRZ_PORT=3100
SLNCTRZ_PUBLIC_URL=https://mcp.example.com/mcp
SLNCTRZ_OWNER_WEB_ENABLED=false
SLNCTRZ_STATE_ROOT=/var/lib/slnctrz-mcp

# Optional non-secret runtime tuning.
SLNCTRZ_MAX_DYNAMIC_CLIENTS=1024
SLNCTRZ_CONTROL_HOST=127.0.0.1
SLNCTRZ_CONTROL_PORT=3101
SLNCTRZ_TELEMETRY_ENABLED=true

# Public ingress allowlists. The public hostname should be present.
SLNCTRZ_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1,[::1]
SLNCTRZ_ALLOWED_ORIGINS=mcp.example.com,localhost,127.0.0.1,[::1]

# Optional policy override. Ordinary managed installs use <stateRoot>/policy.json.
# SLNCTRZ_POLICY_FILE=/var/lib/slnctrz-mcp/policy.json

# Static confidential-client secrets belong in the optional client.env loaded by systemd,
# not in this file. Owner authentication normally uses the managed recovery passphrase.
