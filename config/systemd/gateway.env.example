# Copy to _runtime/gateway.env on the deployment host.
# Replace example values with that host's public endpoint and ingress allowlists.
SLNCTRZ_HOST=0.0.0.0
SLNCTRZ_PORT=3100
SLNCTRZ_MAX_DYNAMIC_CLIENTS=1024
SLNCTRZ_PUBLIC_URL=https://mcp.example.com/mcp
SLNCTRZ_ALLOWED_HOSTS=mcp.example.com
SLNCTRZ_ALLOWED_ORIGINS=mcp.example.com,claude.ai,chatgpt.com,grok.com,localhost,127.0.0.1,[::1]
